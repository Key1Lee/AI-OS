# Shared server environment. This file is an example and is not auto-loaded.
# Set real credentials in a secret manager or private process environment.
AI_OS_PROVIDER_QWEN_ENABLED=true
QWEN_BASE_URL=http://127.0.0.1:8080/v1
# Set QWEN_MODEL to the alias actually served by the validated local runtime.
QWEN_MODEL=

AI_OS_PROVIDER_OPENAI_ENABLED=false
ALLOW_OPENAI=false
OPENAI_MODEL=
OPENAI_API_KEY=
AI_OS_PROVIDER_CLAUDE_ENABLED=false
ALLOW_CLAUDE=false
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ALLOW_CLOUD_ESCALATION=false
CLOUD_CALL_BUDGET=0
# Optional declared capacity, from a validated model profile:
# OPENAI_CONTEXT_WINDOW=...
# CLAUDE_CONTEXT_WINDOW=...

AI_OS_PROVIDER_JEV_ENABLED=false
ALLOW_JEV=false
JEV_MODEL=
TYPESAFE_API_KEY=
AI_OS_JEV_DAILY_CALLS=0
AI_OS_JEV_PER_RUN_CALLS=1
# Optional protected paths: MODEL_AUDIT_FILE, CLOUD_BUDGET_FILE,
# AI_OS_EVENT_FILE, AI_OS_JEV_BUDGET_FILE. Tests should use temporary files.
