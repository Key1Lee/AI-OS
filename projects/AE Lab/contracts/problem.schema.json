{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ae-problem-v1",
  "title": "AE Lab reusable problem/scenario contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "problem_id",
    "title",
    "neutral_title",
    "domain",
    "business_context",
    "difficulty",
    "kind",
    "skills_tested",
    "tables",
    "sample_rows",
    "requirements",
    "expected_output_grain",
    "hidden_edge_cases",
    "learner_prompt",
    "learner_answer",
    "evaluation_rules",
    "hidden_tests",
    "followups",
    "mastery_tags",
    "hints",
    "solution",
    "transfer_from",
    "modes",
    "artifacts",
    "recall"
  ],
  "properties": {
    "contract_version": {
      "const": "ae-problem-v1"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "neutral_title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "business_context": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "dimensions",
        "rationale"
      ],
      "properties": {
        "level": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "L6"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "minProperties": 1
        }
      }
    },
    "kind": {
      "enum": [
        "sql",
        "modeling",
        "debug",
        "architecture",
        "code",
        "incident",
        "reasoning"
      ]
    },
    "skills_tested": {
      "$ref": "#/$defs/tags"
    },
    "mastery_tags": {
      "$ref": "#/$defs/tags"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "columns"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "columns": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "sample_rows": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expected_output_grain": {
      "type": "string",
      "minLength": 1
    },
    "hidden_edge_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learner_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction",
        "requirements",
        "proposal",
        "answer_fields"
      ],
      "properties": {
        "prediction": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposal": {
          "type": "string"
        },
        "answer_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "learner_answer": {
      "type": [
        "object",
        "null"
      ]
    },
    "evaluation_rules": {
      "type": "object",
      "required": [
        "adapter",
        "criteria"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sql_challenge_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "hidden_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "solution": {
      "type": "string",
      "minLength": 1
    },
    "transfer_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "LEARN",
          "PRACTICE",
          "INTERVIEW",
          "DEBUG",
          "SYSTEM_DESIGN",
          "INCIDENT",
          "REVIEW",
          "PERFORMANCE"
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "recall": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "accepted"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            },
            "minItems": 1
          },
          "concepts": {
            "$ref": "#/$defs/tags"
          }
        }
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,2}$"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
