        },
        "text": "=NORTHSTAR WORKFLOW ERROR [{{$json.severity}}]\nWorkflow: {{$json.workflow_name}}\nExecution: {{$json.execution_id}}\nNode: {{$json.node_name}}\nCode: {{$json.error_code}}\n{{$json.error_message}}\nAction: {{$json.action}}",
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
