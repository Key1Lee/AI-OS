{
  "contract_version": "semantic-catalog-v1",
  "scope": "synthetic_scenario",
  "entities": {
    "Order": {
      "name": "Order",
      "description": "Canonical order entity in synthetic commerce",
      "identifier": "order_id",
      "identifier_type": "canonical_string",
      "source": "fct_orders",
      "grain": "order",
      "owner": "Commerce Operations (synthetic)",
      "relationships": {
        "Customer": "N:1",
        "Product": "N:1"
      },
      "identity_policy": "A canonical source order_id identifies one logical order; versions must be resolved by Modeling."
    },
    "Customer": {
      "name": "Customer",
      "description": "Canonical customer entity in synthetic commerce",
      "identifier": "customer_id",
      "identifier_type": "canonical_string",
      "source": "dim_customers",
      "grain": "customer",
      "owner": "Commerce Operations (synthetic)",
      "relationships": {
        "Order": "1:N"
      },
      "identity_policy": "Use canonical customer_id. Guest email and CRM account_id require explicit upstream identity mapping; ambiguity is not resolved by this metric."
    },
    "Product": {
      "name": "Product",
      "description": "Canonical product entity in synthetic commerce",
      "identifier": "product_id",
      "identifier_type": "canonical_string",
      "source": "dim_products",
      "grain": "product",
      "owner": "Commerce Operations (synthetic)",
      "relationships": {
        "Order": "1:N"
      },
      "identity_policy": "One canonical product_id; this bounded fixture assigns one product to an order. Multi-product attribution requires a separately approved allocation contract."
    }
  },
  "dimensions": {
    "date": {
      "name": "date",
      "entity": "Order",
      "type": "date",
      "description": "Reporting date from the metric event time and timezone, not processing time",
      "allowed_values": null,
      "source": "fct_orders",
      "time_behavior": "event_time_in_metric_timezone",
      "owner": "Finance (synthetic)",
      "relationship": "Order 1:1 reporting date"
    },
    "channel": {
      "name": "channel",
      "entity": "Order",
      "type": "string",
      "description": "Sales channel recorded on the order",
      "allowed_values": [
        "web",
        "store",
        "marketplace"
      ],
      "source": "fct_orders",
      "time_behavior": "at_order_event",
      "owner": "Commerce Operations (synthetic)",
      "relationship": "Order 1:1 channel"
    },
    "region": {
      "name": "region",
      "entity": "Customer",
      "type": "string",
      "description": "Customer region at this modeled snapshot, not historical SCD reconstruction",
      "allowed_values": [
        "north",
        "south"
      ],
      "source": "dim_customers",
      "time_behavior": "current_snapshot",
      "owner": "Customer Operations (synthetic)",
      "relationship": "Order N:1 Customer"
    },
    "product_category": {
      "name": "product_category",
      "entity": "Product",
      "type": "string",
      "description": "Category of the single product per order in this bounded domain; no item joins",
      "allowed_values": [
        "electronics",
        "home"
      ],
      "source": "dim_products",
      "time_behavior": "current_snapshot",
      "owner": "Merchandising (synthetic)",
      "relationship": "Order N:1 Product; multi-product orders unsupported"
    }
  },
  "measures": {
    "gross_order_value": {
      "name": "gross_order_value",
      "source": "fct_orders",
      "field": "gross_order_value_cents",
      "grain": "order",
      "aggregation": "SUM",
      "description": "Order amount before refunded amounts in exact integer USD cents",
      "owner": "Finance (synthetic)"
    },
    "refund_amount": {
      "name": "refund_amount",
      "source": "fct_order_refunds",
      "field": "refund_amount_cents",
      "grain": "order",
      "aggregation": "SUM",
      "description": "Already-modeled sum of refunded amounts through snapshot as_of, one row per order",
      "owner": "Finance (synthetic)"
    },
    "order_count": {
      "name": "order_count",
      "source": "fct_orders",
      "field": "order_id",
      "grain": "order",
      "aggregation": "COUNT",
      "description": "One eligible logical order contributes one; never count item rows",
      "owner": "Commerce Operations (synthetic)"
    }
  },
  "assets": {
    "orders_raw": {
      "parents": [],
      "owner": "Source systems"
    },
    "refunds_raw": {
      "parents": [],
      "owner": "Source systems"
