  "reference_solution": "SELECT sku,quantity,event_id FROM inventory_events WHERE valid IS TRUE AND observed_at IS NOT NULL AND sku IS NOT NULL QUALIFY ROW_NUMBER() OVER(PARTITION BY sku ORDER BY observed_at DESC,event_id DESC)=1",
  "solution_explanation": "Eligibility must be applied before ranking. Preserving unknown and zero quantities is different from filtering invalid observations.",
  "hints": [
    "Identify observations that are allowed to represent current state.",
    "An invalid latest row must not suppress an older valid one.",
    "Rank eligible observations with a stable event-ID tie breaker."
  ],
  "senior_review": "Defend source validity, ordering and unknown quantities. This is a transfer exercise for deduplication with a materially different eligibility rule.",
