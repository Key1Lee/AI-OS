  "reference_solution": "WITH latest AS (SELECT * FROM transaction_events QUALIFY ROW_NUMBER() OVER(PARTITION BY event_id ORDER BY ingest_seq DESC)=1) SELECT CAST(occurred_at AT TIME ZONE 'UTC' AS DATE) AS settlement_day,SUM(COALESCE(amount,0)) AS net_amount,COUNT(*) AS event_count FROM latest WHERE status='settled' AND occurred_at>=TIMESTAMPTZ '2026-09-01 00:00:00+00' AND occurred_at<TIMESTAMPTZ '2026-10-01 00:00:00+00' GROUP BY 1",
  "solution_explanation": "Select final event state before filtering. Convert calendar grouping to UTC explicitly and use a half-open month. Refunds remain signed.",
  "hints": [
    "A status correction can remove an earlier settled version.",
    "Deduplication and eligibility are separate stages.",
    "Apply UTC bounds to the chosen versions, then aggregate by their UTC date."
  ],
  "senior_review": "Reconcile the close with signed ledger events and document the restatement policy. Ingestion time is not the financial event date.",
