  "reference_solution": "WITH cohort AS (SELECT user_id,CAST(signed_up_at AT TIME ZONE 'UTC' AS DATE) AS cohort_day FROM users WHERE signed_up_at>=TIMESTAMPTZ '2026-09-01 00:00:00+00' AND signed_up_at<TIMESTAMPTZ '2026-10-01 00:00:00+00'), retained AS (SELECT DISTINCT c.user_id FROM cohort c JOIN session_events e ON c.user_id=e.user_id AND e.event_type='session_start' AND CAST(e.event_at AT TIME ZONE 'UTC' AS DATE)=c.cohort_day+7) SELECT c.cohort_day,COUNT(*) AS cohort_users,COUNT(r.user_id) AS retained_users,COUNT(r.user_id)*1.0/COUNT(*) AS retention_rate FROM cohort c LEFT JOIN retained r USING(user_id) GROUP BY c.cohort_day",
  "solution_explanation": "Freeze the cohort before joining return events. Match exact UTC calendar day seven, reduce to distinct users, and preserve non-returners in the denominator.",
  "hints": [
    "Cohort membership does not depend on return activity.",
    "Day seven is one calendar date, not a rolling duration.",
    "Join distinct qualifying users back to the complete UTC cohort."
  ],
  "senior_review": "State precise entity, qualifying action, timezone, calendar interval and observation completeness. No fabricated missing future data is added as a hidden requirement.",
