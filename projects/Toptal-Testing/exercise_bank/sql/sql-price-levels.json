  "reference_solution": "SELECT product_id,category,price FROM products WHERE category IS NOT NULL AND price IS NOT NULL QUALIFY DENSE_RANK() OVER(PARTITION BY category ORDER BY price DESC)<=2",
  "solution_explanation": "DENSE_RANK orders distinct value levels without leaving rank gaps for ties. Filter unknown categories and prices before ranking.",
  "hints": [
    "Distinguish row count from distinct price-level count.",
    "Ties at the highest price must leave room for the next distinct price.",
    "Rank distinct ordered values within each category and keep two levels."
  ],
  "senior_review": "Tie semantics belong in the output contract. Test ties at both included levels and signed or unknown prices.",
