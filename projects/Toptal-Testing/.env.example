# Evaluator selection. Copying this file does not load it automatically.
# Export values in Terminal before launching; never commit a real key.
EVALUATOR_PROVIDER=auto
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=Qwen3.8-27B-UD-Q4_KS-C256K
QWEN_API_KEY=local
QWEN_HEALTH_TIMEOUT_SECONDS=1.5
QWEN_TIMEOUT_SECONDS=90

# Used only when EVALUATOR_PROVIDER=openai.
OPENAI_API_KEY=
TRAINING_LLM_MODE=auto
TRAINING_MODEL=gpt-5.6-sol
TRAINING_SESSION_QUESTIONS=2
TRAINING_GOAL=Senior forward-deployed engineering interview readiness

# Optional isolated database path for testing or a separate learner profile.
# TRAINING_DB=/absolute/path/to/training.db

# Senior AE browser trainer (separate app; SQL needs no LLM/key).
# AE_TRAINER_DB=/absolute/path/to/ae-trainer.db
AE_SQL_TIMEOUT=5
# Future reasoning integration will use a separately configured provider.
# No network evaluator is invoked by the current SQL release.
