# Run: uv run python scripts/configure.py (creates random local tokens and .env).
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://peopleops:replace-with-a-random-local-password@127.0.0.1:55433/peopleops_policy
# JSON array of {token_sha256, identity: {subject, tenant, region, role}}.
# Raw tokens are NOT stored in this map. The configure script writes hashes here.
AUTH_CREDENTIALS=[]
N8N_ENCRYPTION_KEY=replace-with-a-random-local-encryption-key
N8N_WEBHOOK_URL=http://127.0.0.1:5680/webhook/peopleops-policy
LLM_PROVIDER=mock
# Local Qwen option: LLM_PROVIDER=qwen_local, LLM_MODEL=<served alias>,
# PROVIDER_BASE_URL=http://host.docker.internal:8080/v1, ALLOW_EXTERNAL_PROVIDER=false.
# Start the existing Mac runtime with scripts/start_local_qwen.py before Compose.
EMBEDDING_PROVIDER=mock
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
ALLOW_EXTERNAL_PROVIDER=false
TOP_K=5
MIN_SIMILARITY=0.18
POLICY_TIMEZONE=UTC

# Standalone enterprise mock: uvicorn app.main:app --port 8811
# These HR_ settings are separate from the earlier pgvector/Qwen service above.
HR_DEMO_MODE=true
HR_LAB_ENABLED=true
HR_LAB_JOB_TIMEOUT_SECONDS=120
# HR_LAB_REPORTS_PATH=/absolute/path/to/isolated/lab/reports
HR_AS_OF_DATE=2026-10-20
# Set as environment variables, or edit config/app.yaml for the mock runtime.
# HR_DATABASE_PATH=/absolute/path/to/enterprise.sqlite3
# HR_SLACK_SIGNING_SECRET=<mock-only secret shared with your local simulator>
