[{"updatedAt":"2026-10-20T13:03:54.000Z","createdAt":"2026-10-20T12:01:31.972Z","id":"qualtricsGold01","name":"Qualtrics TEST → Bronze → Silver → Gold metrics","description":null,"active":true,"isArchived":false,"nodes":[{"id":"manual","name":"Run synthetic survey","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-1080,0],"parameters":{}},{"id":"webhook","name":"Test application webhook","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1080,220],"webhookId":"qualtrics-gold-test","parameters":{"httpMethod":"POST","path":"qualtrics-gold-test","responseMode":"responseNode","options":{}}},{"id":"start-mock-qualtrics-export","name":"Start mock Qualtrics export","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-840,80],"parameters":{"method":"POST","url":"http://survey-analytics:8812/mock-qualtrics/exports","options":{"timeout":10000}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":1000},{"id":"check-export-ready","name":"Check export ready","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-600,80],"parameters":{"method":"GET","url":"={{ 'http://survey-analytics:8812/mock-qualtrics/exports/' + $json.export_id }}","options":{"timeout":10000}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":1000},{"id":"download-synthetic-responses","name":"Download synthetic responses","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-360,80],"parameters":{"method":"GET","url":"={{ 'http://survey-analytics:8812/mock-qualtrics/exports/' + $json.export_id + '/file' }}","options":{"timeout":10000}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":1000},{"id":"bronze---preserve-raw-export","name":"BRONZE - preserve raw export","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-120,80],"parameters":{"method":"POST","url":"http://survey-analytics:8812/layers/bronze","options":{"timeout":10000},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify($json) }}"},"retryOnFail":true,"maxTries":3,"waitBetweenTries":1000},{"id":"silver---validate-and-deduplicate","name":"SILVER - validate and deduplicate","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[120,80],"parameters":{"method":"POST","url":"http://survey-analytics:8812/layers/silver","options":{"timeout":10000},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({batch_id: $json.batch_id}) }}"},"retryOnFail":true,"maxTries":3,"waitBetweenTries":1000},{"id":"gold---publish-survey-metrics","name":"GOLD - publish survey metrics","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[360,80],"parameters":{"method":"POST","url":"http://survey-analytics:8812/layers/gold","options":{"timeout":10000},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({batch_id: $json.batch_id}) }}"},"retryOnFail":true,"maxTries":3,"waitBetweenTries":1000},{"id":"respond","name":"Return metrics to test application","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[600,80],"parameters":{"respondWith":"json","responseBody":"={{ $json }}","options":{}}},{"id":"source-note","name":"source-note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-1110,-310],"parameters":{"content":"## 1 · QUALTRICS TEST SOURCE\n**Synthetic only — no Qualtrics account or API token.**\nManual run or POST webhook → start export → check ready → download.\nLocal fixture is immediately ready. Real adapter would need bounded polling, backoff, credentials and export parsing.\n**Closed cohort:** 20 invited; 15 raw deliveries including duplicate, revision and invalid score.","width":720,"height":230,"color":4}},{"id":"bronze-note","name":"bronze-note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-150,-310],"parameters":{"content":"## 2 · BRONZE\nImmutable export + SHA-256 batch key.\n15 deliveries → **14 unique versions**.\n1 exact duplicate ignored.\nSQLite: bronze_batches + bronze_responses.\nReplay does not create new rows.","width":260,"height":230,"color":4}},{"id":"silver-note","name":"silver-note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[120,-310],"parameters":{"content":"## 3 · SILVER\nLatest version per response ID, then validate types/ranges.\n**12 accepted · 1 quarantined · 1 superseded.**\n10 completed + 2 partial.\nInvalid newest version never revives an older answer.","width":260,"height":230,"color":4}},{"id":"gold-note","name":"gold-note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[390,-310],"parameters":{"content":"## 4 · GOLD\n**7 metrics** with explicit denominators:\nResponse rate · completion rate · engagement mean · favorable % · CSAT · eNPS · median duration.\nVersioned, atomic SQLite aggregate snapshot.\nSmall department/question groups: all department slices withheld to prevent subtraction disclosure.","width":500,"height":230,"color":4}},{"id":"inspect-note","name":"inspect-note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[-150,340],"parameters":{"content":"## INSPECT THE DATA FLOW\nExecute workflow, then click each green HTTP node → Output → JSON.\nProduction webhook: POST http://127.0.0.1:5680/webhook/qualtrics-gold-test\nGold viewer: http://127.0.0.1:8812 · API: /layers · SQLite: survey_analytics/data/survey.sqlite3\nRetries: 3 attempts, 1-second wait, 10-second request timeout. Errors stop publication.\nOnly this synthetic workflow saves node outputs; HR chat execution settings are unchanged.","width":1040,"height":190,"color":4}}],"connections":{"Run synthetic survey":{"main":[[{"node":"Start mock Qualtrics export","type":"main","index":0}]]},"Test application webhook":{"main":[[{"node":"Start mock Qualtrics export","type":"main","index":0}]]},"Start mock Qualtrics export":{"main":[[{"node":"Check export ready","type":"main","index":0}]]},"Check export ready":{"main":[[{"node":"Download synthetic responses","type":"main","index":0}]]},"Download synthetic responses":{"main":[[{"node":"BRONZE - preserve raw export","type":"main","index":0}]]},"BRONZE - preserve raw export":{"main":[[{"node":"SILVER - validate and deduplicate","type":"main","index":0}]]},"SILVER - validate and deduplicate":{"main":[[{"node":"GOLD - publish survey metrics","type":"main","index":0}]]},"GOLD - publish survey metrics":{"main":[[{"node":"Return metrics to test application","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","executionTimeout":120,"saveExecutionProgress":false,"saveDataSuccessExecution":"all","saveDataErrorExecution":"all","saveManualExecutions":true,"timeSavedMode":"fixed","timeSavedPerExecution":10,"availableInMCP":true,"errorWorkflow":"qualtricsGoldError01"},"staticData":null,"meta":null,"nodeGroups":[],"pinData":{},"versionId":"cb9cbf9c-8c55-4be7-b8a8-d255ec4ccb17","activeVersionId":"cb9cbf9c-8c55-4be7-b8a8-d255ec4ccb17","versionCounter":4,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-10-20T12:01:31.975Z","createdAt":"2026-10-20T12:01:31.975Z","role":"workflow:owner","workflowId":"qualtricsGold01","projectId":"276h5sLrecSMhykX","project":{"updatedAt":"2026-10-20T07:20:06.351Z","createdAt":"2026-10-19T01:42:51.503Z","id":"276h5sLrecSMhykX","name":"Key Lee <ask.keylee@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"d6ae02ec-6172-4db1-8eda-bec825e7d750"}}],"versionMetadata":{"name":null,"description":null}}]