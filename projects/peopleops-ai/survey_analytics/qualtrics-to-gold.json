        -360,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://survey-analytics:8812/mock-qualtrics/exports/' + $json.export_id + '/file' }}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-TOKEN",
              "value": "FAKE-QUALTRICS-LOCAL-ONLY-NOT-A-REAL-TOKEN"
