        "method": "POST",
        "url": "http://survey-analytics:8812/layers/gold",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({batch_id: $json.batch_id}) }}"
