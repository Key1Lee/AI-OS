{
  "id": "qualtricsGold01",
  "name": "Qualtrics TEST \u2192 Bronze \u2192 Silver \u2192 Gold metrics",
  "active": false,
  "nodes": [
    {
      "id": "manual",
      "name": "Run synthetic survey",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1080,
        0
      ],
      "parameters": {}
    },
    {
      "id": "webhook",
      "name": "Test application webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1080,
        220
      ],
      "webhookId": "qualtrics-gold-test",
      "parameters": {
        "httpMethod": "POST",
        "path": "qualtrics-gold-test",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "start-mock-qualtrics-export",
      "name": "Start mock Qualtrics export",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -840,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://survey-analytics:8812/mock-qualtrics/exports",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-TOKEN",
              "value": "FAKE-QUALTRICS-LOCAL-ONLY-NOT-A-REAL-TOKEN"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "check-export-ready",
      "name": "Check export ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://survey-analytics:8812/mock-qualtrics/exports/' + $json.export_id }}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-TOKEN",
              "value": "FAKE-QUALTRICS-LOCAL-ONLY-NOT-A-REAL-TOKEN"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
