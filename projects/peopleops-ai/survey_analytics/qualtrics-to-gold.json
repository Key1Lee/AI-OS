      "parameters": {
        "method": "POST",
        "url": "http://survey-analytics:8812/layers/bronze",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "silver---validate-and-deduplicate",
      "name": "SILVER - validate and deduplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://survey-analytics:8812/layers/silver",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({batch_id: $json.batch_id}) }}"
