      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const response=$json; const data=response.body || response; return [{json:{...data,question:$('Webhook').first().json.body.question,statusCode:response.statusCode >= 400 ? response.statusCode : undefined}}];"
      }
    },
    {
