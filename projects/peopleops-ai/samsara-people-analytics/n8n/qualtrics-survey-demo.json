    {
      "id": "build-grounded-answer",
      "name": "Build Grounded Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -80
      ],
      "parameters": {
        "jsCode": "const response=$json; const data=response.body || response; return [{json:{...data,statusCode:response.statusCode >= 400 ? response.statusCode : undefined}}];"
      }
    },
    {
      "id": "attach-execution-receipt",
      "name": "Attach Execution Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -80
      ],
      "parameters": {
        "jsCode": "if($json.error || $json.validation?.status !== 'PASS' || !$json.report || !$json.ai) return [{json:{...$json,statusCode:$json.statusCode || ($json.validation?.status === 'FAIL' ? 409 : 502)}}];\nreturn [{json:{...$json,orchestration:{mode:'n8n',executionId:$execution.id,workflowId:$workflow.id}}}];"
      }
    },
    {
      "id": "handle-failure",
      "name": "Handle Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        230
      ],
      "parameters": {
        "jsCode": "const statusCode = $json.statusCode || 502; return [{json:{error:$json.error && typeof $json.error === 'string' ? $json.error : 'A workflow service failed. Check mock data, reference validation and execution logs.',statusCode,validation:{status:'NOT VERIFIED'},orchestration:{mode:'n8n',executionId:$execution.id,workflowId:$workflow.id}}}];"
      }
    },
    {
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.statusCode || 200 }}"
        }
      }
    }
