{
  "id": "peopleInsightsAI01",
  "name": "People Insights AI \u00b7 IBM synthetic reporting assistant",
  "active": false,
  "nodes": [
    {
      "id": "webhook",
      "name": "Chat request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "people-insights-chat",
      "parameters": {
        "httpMethod": "POST",
        "path": "people-insights-chat",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "api",
      "name": "Python chat and report API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8813/api/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Demo-Key",
              "value": "={{ $json.headers['x-demo-key'] || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "respond",
      "name": "Return structured answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        570,
        -90
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    },
    {
      "id": "failure",
      "name": "Return safe workflow error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        570,
        140
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"error\", \"message\": \"The report backend could not complete the request. Check the demo identity and API health, or switch to Direct API. No scores were generated by n8n.\", \"options\": [], \"report\": null}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "note",
      "name": "Read the data flow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        -290
      ],
      "parameters": {
        "width": 830,
        "height": 210,
        "color": 4,
        "content": "## PEOPLE INSIGHTS AI \u00b7 SYNTHETIC IBM SAMPLE\nChat \u2192 webhook \u2192 Python /api/chat \u2192 structured report or clarification \u2192 chat.\nPython owns request validation, server-side department authorization, session memory, pandas metrics and CSV exports. No LLM arithmetic.\nConfigure the HTTP node URL for your backend. Native n8n: 127.0.0.1:8813; existing macOS container: host.docker.internal:8813.\nPublic demo identity header is forwarded; arbitrary roles are rejected. 10s timeout, no automatic chat retries. Failures return a safe message. IBM is not Qualtrics EX25."
      }
    }
  ],
  "connections": {
    "Chat request": {
      "main": [
        [
          {
            "node": "Python chat and report API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Python chat and report API": {
      "main": [
        [
          {
            "node": "Return structured answer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return safe workflow error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 20,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
